{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Database": "Data Source=appdata/transfer-proof-verifier.db", "Redis": "" },
  "Security": { "TokenKey": "", "MerchantApiKey": "" },
  "Tokens": { "InstallTokenTtl": "00:15:00", "SessionTtl": "00:30:00" },
  "Storage": { "Root": "storage", "MaxUploadBytes": 52428800 },
  "Ffmpeg": { "Path": "ffmpeg", "ScanTailSeconds": 60, "FramesPerSecond": 2, "TimeoutSeconds": 60, "LoadingVarianceThreshold": 120 },
  "Tesseract": { "Path": "tesseract" },
  "Gemini": { "Endpoint": "https://generativelanguage.googleapis.com", "Model": "gemini-2.5-flash", "ApiKey": "", "Proxy": "" },
  "Extraction": { "Provider": "Auto", "MaxFrames": 3 },
  "Matching": { "ReceiverNameThreshold": 0.8, "SenderNameThreshold": 0.7, "MinConfidence": 0.6 },
  "Signing": { "PrivateKeyPemPath": "appdata/signing-key.pem" },
  "Webhook": { "Url": "", "RetryDelaysSeconds": [1, 4, 9] }
